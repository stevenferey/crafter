{
  "name": "crafter-backend",
  "version": "1.0.0",
  "description": "Backend API for Crafter CRA application",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "bash migrations/run-all.sh",
    "db:upgrade": "bash migrations/migrate.sh",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "cra",
    "backend",
    "api",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/pdfmake": "^0.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.0",
    "pdfmake": "^0.3.0",
    "pg": "^8.13.1",
    "resend": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "@typescript/native": "npm:typescript@^7.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.59.0"
  }
}
